rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isCompanyAdmin() {
      return isSignedIn() && request.auth.token.role == 'companyAdmin';
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superAdmin';
    }

    function userCompanyId() {
      return request.auth.token.companyId;
    }

    // Companies collection
    match /companies/{companyId} {
      // Allow read only for authenticated users of that company
      allow read: if isSignedIn() && userCompanyId() == companyId;
      allow write: if isSuperAdmin();

      // Users sub-collection (Phase 2)
      match /users/{userId} {
        // Each user can read their own profile
        allow read: if isSignedIn() &&
          (userId == request.auth.uid || isCompanyAdmin() || isSuperAdmin()) &&
          userCompanyId() == companyId;

        // Company admins can create and manage users
        allow create, update, delete: if isCompanyAdmin() && userCompanyId() == companyId;
      }

      // Teams sub-collection (Phase 3)
      match /teams/{teamId} {
        // Team members can read team data
        allow read: if isSignedIn() && userCompanyId() == companyId;

        // Company admins can manage teams
        allow create, update, delete: if isCompanyAdmin() && userCompanyId() == companyId;

        // Tasks sub-collection (Phase 4)
        match /tasks/{taskId} {
          allow read: if isSignedIn() && userCompanyId() == companyId;
          allow write: if isCompanyAdmin() && userCompanyId() == companyId;
        }

        // Logs sub-collection (Phase 5)
        match /logs/{logId} {
          allow read: if isSignedIn() && userCompanyId() == companyId;
          allow write: if isCompanyAdmin() && userCompanyId() == companyId;
        }
      }
    }

    // Deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
